AAEP_DATABASE_URL=postgresql+psycopg://adaptive:adaptive@localhost:5432/adaptive
# Set this to the port in AAEP_DATABASE_URL when local port 5432 is unavailable.
AAEP_POSTGRES_PORT=5432
AAEP_ALLOWED_REPOSITORY_ROOTS=/Users/your-name/Desktop
AAEP_DIRTY_TREE_POLICY=CAPTURE
AAEP_MAX_FILE_SIZE_BYTES=2097152
AAEP_MAX_FILE_COUNT=50000
AAEP_MAX_TOTAL_BYTES=536870912
AAEP_MAX_SCAN_SECONDS=60
AAEP_GIT_TIMEOUT_SECONDS=10
AAEP_LANGUAGE_PROFILER_CONFIGURATION_VERSION=language-profiler-v1
AAEP_POLYGLOT_THRESHOLD_PERCENT=5.0
AAEP_ENCODING_FALLBACK=latin-1
AAEP_SCANNER_CONFIGURATION_VERSION=scanner-v1
